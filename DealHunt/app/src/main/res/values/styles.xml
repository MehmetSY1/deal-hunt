<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DealHunt" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/accent_green</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorControlNormal">@color/text_muted</item>
        <item name="colorControlActivated">@color/accent_green</item>
        <item name="editTextStyle">@style/DealHuntEditText</item>
        <item name="swipeRefreshLayoutProgressSpinnerBackgroundColor">@color/bg_surface</item>
    </style>

    <style name="DealHuntEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:background">@drawable/bg_search</item>
    </style>

    <style name="ExpandedTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
